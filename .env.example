# Copy to .env. Credentials stay on the backend.
XINXIN_HOST=127.0.0.1
XINXIN_PORT=8000
XINXIN_DATA_DIR=./data
# One active job suits 2 CPU / 4 GB. Other jobs remain durably queued.
XINXIN_TASK_CONCURRENCY=1
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1
# auto uses the pinned local E5 model when installed; dense fails if unavailable.
# lexical explicitly selects the smallest keyword-only fallback.
XINXIN_SKILL_ENCODER=auto
XINXIN_MODEL=deepseek-flash
XINXIN_MODEL_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_API_KEY=
# Exact trusted web/native origins, comma separated.
XINXIN_CORS_ORIGINS=http://localhost:5188,http://127.0.0.1:5188,https://localhost,http://localhost,capacitor://localhost
# Optional: set your own first-account bootstrap code; otherwise data/bootstrap.code is generated.
XINXIN_SETUP_TOKEN=

